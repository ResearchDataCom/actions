@Misc{2025:cooldowns,
  author =    {William Woodruff},
  title =     {We should all be using dependency cooldowns},
  howpublished = {\url{https://blog.yossarian.net/2025/11/21/We-should-all-be-using-dependency-cooldowns}},
  month =     {November},
  year =      2025,
  note =      {Accessed: 2026-08-03},
  annote =    {Dependency cooldowns are a cheap way to avoid many (but
                  not all) supply chain attacks.  By waiting to update
                  a dependency pin, one gives upstream developers and
                  supply chain security vendors time to discover and
                  stop an attack.}
}
